# Segredos
.env
.env.*
# A chave do banco local é pública e igual em todo computador.
!app/.env.docker
*.key

# Dados de clientes e exportações (nunca versionar)
Trello/
*.csv
*.xlsx
exportacoes/

# Configuração local do Claude Code
.claude/settings.local.json

# Sistema
Thumbs.db
.DS_Store
node_modules/
*.zip
# Cópia de referência da interface da Educação (repositório próprio)
educacao/

# Site compilado (gerado pela rotina de publicação)
dist/

# Arquivos de trabalho das skills de design
.taste-skill/

# Conversor da planilha do site compilado (npm run converter-planilha)
app/ferramentas/planilha-do-site/.saida/

# Resultados dos testes de ponta a ponta (Playwright)
app/playwright-report/
app/test-results/

# OpenSpec (propostas, specs e os comandos /opsx): ficam só no computador
openspec/
.claude/commands/opsx/
.claude/skills/openspec-*/
