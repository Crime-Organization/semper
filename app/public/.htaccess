# SEMPER publicado (gerado a partir de app/ pela rotina de publicação do GitHub).

DirectoryIndex index.html

<IfModule mod_headers.c>
  # A página principal é sempre conferida: assim cada publicação nova chega na hora.
  <FilesMatch "(^$|\.html$)">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Arquivos com código de versão no nome (index-AbC123xy.js) nunca mudam: o navegador guarda por um ano.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Proteções básicas: o site não abre dentro de outro site, e o navegador não adivinha tipos de arquivo.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Sempre HTTPS: depois da primeira visita, o navegador nem tenta abrir o endereço sem o "s" (1 ano).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Política de conteúdo: só roda script deste site e só conversa com o banco e as consultas de CNPJ e CEP.
  # Se alguém conseguir injetar código numa página, ele não roda nem manda dados para fora.
  # Ao incluir um serviço novo (ex.: outro site de consulta), acrescente o endereço em connect-src.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://uzafzwqjpxxiovfunxfm.supabase.co https://publica.cnpj.ws https://brasilapi.com.br https://viacep.com.br; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  # Recursos do aparelho que o SEMPER não usa ficam bloqueados.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Endereços do sistema (/inicio/, /pessoas/...) não são pastas: todos abrem o index.html,
# e o próprio SEMPER mostra a tela certa. Arquivos que existem são servidos normalmente.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Um endereço só: www.semper.app.br vai para semper.app.br, mantendo o caminho e os parâmetros.
  RewriteCond %{HTTP_HOST} ^www\.semper\.app\.br$ [NC]
  RewriteRule ^ https://semper.app.br%{REQUEST_URI} [R=301,L]
  # O endereço antigo (semper.bragaferreira.adv.br) foi desligado: responde "não existe mais" (410)
  # e não leva ao SEMPER. O SEMPER fica só em semper.app.br.
  RewriteCond %{HTTP_HOST} ^semper\.bragaferreira\.adv\.br$ [NC]
  RewriteRule ^ - [G,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Arquivos ocultos (.git e outros) nunca são servidos. A pasta .well-known continua aberta,
# porque a Hostinger a usa para renovar o certificado SSL.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/\.git(/|$)
