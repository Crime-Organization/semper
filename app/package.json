  "type": "module",
  "scripts": {
    "dev": "vite --port 8090 --strictPort",
    "teste": "vite --mode falso --port 8091 --strictPort",
    "build": "npm run tipos && npm run lint && vite build",
    "tipos": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "testar": "TZ=America/Sao_Paulo vitest run",
    "verificar": "npm run tipos && npm run lint && npm run testar",
    "testar-telas": "TZ=America/Sao_Paulo playwright test",
    "ver": "vite preview --port 8092",
    "converter-planilha": "rolldown ferramentas/planilha-do-site/converter.ts --platform node --format esm --file ferramentas/planilha-do-site/.saida/converter.mjs --logLevel warn && node ferramentas/planilha-do-site/.saida/converter.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@supabase/auth-js": "^2.118.0",
    "@supabase/postgrest-js": "^2.118.0",
    "@supabase/storage-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "rolldown": "1.2.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
